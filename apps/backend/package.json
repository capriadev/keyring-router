{
  "name": "@keyring-router/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Keyring Router local NestJS gateway.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "tsc": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.spec.ts",
    "e2e": "node --import tsx src/e2e/first-slice.e2e.ts",
    "verify:boot": "node scripts/boot-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/dal/migrate.cli.ts"
  },
  "dependencies": {
    "@keyring-router/contracts": "*",
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "@nestjs/platform-fastify": "^12.0.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^7.0.2"
  }
}
