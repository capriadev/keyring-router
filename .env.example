# Keyring Router boot configuration. Copy this file to `.env` and fill it in. Never commit `.env`.

# Local interface. Keep it on the loopback address unless a remote exposure was designed on purpose.
KR_HOST=127.0.0.1
KR_PORT=4310

# SQLite file. A relative path resolves against the repository root.
KR_DB_PATH=apps/backend/data/kr.db

# Pepper for the credential secrets: 32 random bytes, base64 or base64url.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# The key is derived from this pepper plus a random salt stored in the database, so neither file
# alone opens the secrets. Losing the pepper makes every stored secret unrecoverable by design:
# there is no recovery path, and the gateway refuses to start if secrets exist without it.
KR_SECRET_PEPPER=

# Argon2id cost of the key derivation. Defaults shown; they derive the key in about 130 ms once per
# process. Raising memory or passes costs startup time and buys resistance against brute force.
KR_ARGON2_MEMORY_KIB=65536
KR_ARGON2_PASSES=3
KR_ARGON2_PARALLELISM=4
